{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dispatch",
  "version": "0.1.1",
  "identifier": "com.dispatch.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dispatch",
        "width": 1100,
        "height": 700,
        "minWidth": 560,
        "minHeight": 360,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNzQ3ODlCNUNEQkMyQjUKUldTMXd0dGNtM2gwZzdmL0NucTFIVk5HYStaVHZVRTBCMkplQlBLMTVCRzMyRjMvSmd6aUMvdzEK",
      "endpoints": [
        "https://github.com/fylzero/dispatch/releases/latest/download/latest.json"
      ]
    }
  }
}
